@extends('layouts/marketing')
@section('content')
<script server>
import sites from '~/config/sites'
import { academyForSite, isAcademyHost } from '~/app/Support/academies'
import { catalogOf } from '~/app/Support/courses'
import { site } from '~/resources/data/site'

// One address, two meanings: on an Academy's own host `/` is that Academy's
// catalog; on Cursio's host it is the marketing page. The layout reads
// `school` too and swaps its chrome, because a view has one layout and cannot
// choose between two.
const school = await academyForSite(requestContext.site())
// An Academy's address with no Academy behind it is not Cursio's home page.
if (!school && isAcademyHost(requestContext.host(), sites.baseDomain, sites.platformHosts))
  notFound()

const entries = school ? await catalogOf(school.id) : []
const academyHome = '/'

const pageTitle = school ? school.name : site.title
const pageDescription = school ? (school.tagline || `Courses from ${school.name}.`) : site.description
const canonicalPath = '/'
</script>
@if(school)
  <div class="mx-auto px-4 py-10 md:px-8 max-w-5xl">
    <CursioCatalog :school="school" :entries="entries" :home="academyHome" api="/api/learn" />
  </div>
@else
  <HomeHero />
  <FeatureBento />
  <HowItWorks />
  <StackCompare />
  <RoadmapList />
  <EarlyAccess />
@endif
@endsection
