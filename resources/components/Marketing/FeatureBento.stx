<script server>
/**
 * Six features, six cells. Column spans add up to 12 on every row
 * (7+5, 4+8, 6+6), so the grid never leaves a hole.
 */
import { featureBySlug } from '~/resources/data/features'

const builder = featureBySlug('course-builder')
const quizzes = featureBySlug('quizzes-certificates')
const video = featureBySlug('video')
const checkout = featureBySlug('checkout')
const cohorts = featureBySlug('cohorts')
const community = featureBySlug('community')

const lessonKinds = [
  { icon: 'i-hugeicons-play-circle', label: 'Video' },
  { icon: 'i-hugeicons-book-open-01', label: 'Reading' },
  { icon: 'i-hugeicons-file-01', label: 'Download' },
  { icon: 'i-hugeicons-help-circle', label: 'Quiz' },
  { icon: 'i-hugeicons-task-01', label: 'Assignment' },
]

const priceKinds = ['One-time', 'Payment plan', 'Subscription', 'Bundle', 'Free']
</script>
<section id="features" class="mx-auto px-4 py-16 md:px-8 md:py-24 max-w-7xl">
  <h2 class="max-w-[22ch] font-semibold text-3xl text-ink tracking-tight md:text-4xl">Everything a course business runs on.</h2>
  <p class="mt-4 max-w-[60ch] leading-relaxed text-muted">Built as one product, so the parts already know about each other.</p>

  <div class="grid gap-4 grid-cols-1 md:grid-cols-12 mt-10">
    <article class="md:col-span-7 p-6 md:p-8 bg-surface border border-line rounded-2xl dot-grid">
      <span class="{{ builder.icon }} size-7 text-accent" aria-hidden="true"></span>
      <h3 class="mt-4 font-semibold text-ink text-xl tracking-tight">{{ builder.title }}</h3>
      <p class="mt-2 max-w-[48ch] leading-relaxed text-muted">{{ builder.summary }}</p>
      <ul class="flex flex-wrap gap-2 mt-6">
        @foreach(lessonKinds as kind)
          <li class="inline-flex gap-2 items-center px-3 h-9 text-ink text-sm bg-surface border border-line rounded-full">
            <span class="{{ kind.icon }} size-4 text-muted" aria-hidden="true"></span>
            {{ kind.label }}
          </li>
        @endforeach
      </ul>
      <p class="mt-6 text-muted text-sm">{{ builder.statusText }}</p>
    </article>

    <article class="md:col-span-5 p-6 md:p-8 bg-tint border border-line rounded-2xl">
      <h3 class="font-semibold text-ink text-xl tracking-tight">{{ quizzes.title }}</h3>
      <p class="mt-2 leading-relaxed text-muted">{{ quizzes.summary }}</p>
