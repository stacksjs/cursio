@extends('layouts/app')
@section('content')
<script server>
import { academyBySlug } from '~/app/Support/academies'
import { outlineOf, publishedCourse } from '~/app/Support/courses'

const academySlug = typeof academy !== 'undefined' ? String(academy) : ''
const courseSlug = typeof course !== 'undefined' ? String(course) : ''
const school = academySlug ? await academyBySlug(academySlug) : null
const academyHome = `/a/${academySlug}`
const found = school ? await publishedCourse(school.id, courseSlug) : null
if (!found)
  notFound()

const outline = found ? await outlineOf(found.id) : { sections: [], lessonIds: [] }
const returnPath = academyHome === '/' ? `/${courseSlug}` : `${academyHome}/${courseSlug}`
const pageTitle = found ? `${found.title} - ${school.name}` : 'Course not found'
const pageDescription = found?.summary || ''
const canonicalPath = returnPath
</script>
@if(found)
  <CursioPlayer :school="school" :course="found" :outline="outline" :home="academyHome" :path="returnPath" api="/api/learn" />
@endif
@endsection
