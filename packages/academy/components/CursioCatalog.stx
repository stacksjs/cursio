<script server>
import { learnBase, runtime, wordsOf } from '@cursio/academy'

// Props: `school` (the Academy), `entries` (its catalog), `home` (where this
// catalog lives in the app) and `api` (where the learner API answers).
const academyHome = home || '/'
// A page with its own headline passes `:heading="false"`.
const showHeading = typeof heading === 'undefined' || (heading !== false && heading !== 'false')

// The catalog a visitor browses: every published Course with what its card
// shows, and the topics they fall under, in the order they first appear.
const words = wordsOf(school)
const base = academyHome === '/' ? '/' : `${academyHome}/`
const cards = entries.map(entry => ({
  ...entry,
  href: `${base}${entry.slug}`,
  levelText: entry.level ? entry.level.charAt(0).toUpperCase() + entry.level.slice(1) : '',
  count: `${entry.lessons} ${entry.lessons === 1 ? words.lesson : words.lessons}`,
  time: runtime(entry.seconds),
}))
const topics = [...new Set(entries.map(entry => entry.topic).filter(Boolean))]
const libraryPath = school ? `${learnBase(api)}/${school.slug}/library` : ''
</script>
<script client>
import { useAuth } from '~/storage/framework/defaults/functions/auth'
import { dashboardApi } from '~/storage/framework/defaults/functions/dashboard-api'

const libraryUrl = {{ libraryPath }}
const home = {{ base }}

const topic = state('')
const watching = state([])
// Points and badges, once the signed-in learner has earned any.
const earned = state(null)

function pickTopic(value) {
  topic.set(topic() === value ? '' : value)
}

onMount(async () => {
  if (!libraryUrl || !useAuth().getToken())
    return
  try {
    const data = await dashboardApi(libraryUrl)
    if (data.achievements && data.achievements.points > 0)
      earned.set(data.achievements)
    // What is unfinished comes first: that is what "continue" means.
    watching.set(data.library.filter(entry => !entry.completed).map(entry => ({ ...entry, href: `${home}${entry.slug}${entry.nextEpisode ? `?episode=${entry.nextEpisode}` : ''}` })))
  }
  catch {
    // Signed out or expired: the catalog is the whole page.
  }
})
</script>
<template>
<div data-stx-content>
@if(school)
  @if(showHeading)
    <h1 class="font-semibold text-4xl text-ink tracking-tight">{{ school.name }}</h1>
    @if(school.tagline)
      <p class="mt-3 max-w-[60ch] text-lg text-muted">{{ school.tagline }}</p>
    @endif
  @endif

  <section class="flex flex-wrap gap-x-8 gap-y-4 items-center mt-10 p-5 bg-surface border border-line rounded-2xl" :hidden="earned() === null" hidden aria-label="What you have earned">
    <p class="text-ink"><span class="font-semibold tabular-nums text-2xl tracking-tight">{{ earned()?.points || 0 }}</span> <span class="text-muted text-sm">points</span></p>
    {{-- Badge icons arrive from the API as class names, so nothing else in a
      template names them. This empty element does, which is what makes the CSS
      scanner of any app that installs the package generate them. --}}
    <span hidden class="i-hugeicons-footprints i-hugeicons-fire i-hugeicons-quiz-01 i-hugeicons-target-02 i-hugeicons-task-done-01 i-hugeicons-award-01 i-hugeicons-champion"></span>
    <ul class="flex flex-wrap gap-2">
      <li :for="badge in earned()?.badges || []" class="inline-flex gap-2 items-center px-3 h-9 text-ink text-sm bg-accent-soft rounded-full" :title="badge.earnedBy">
        <span class="size-4 text-accent" :class="badge.icon" aria-hidden="true"></span>{{ badge.title }}
      </li>
    </ul>
    <p class="text-muted text-sm" :hidden="!earned()?.next">Next: {{ earned()?.next?.title }}. {{ earned()?.next?.earnedBy }}.</p>
  </section>

  <section class="mt-10" :hidden="watching().length === 0" hidden aria-labelledby="continue-heading">
    <h2 id="continue-heading" class="font-medium text-muted text-sm">Continue watching</h2>
    <ul class="grid gap-3 grid-cols-1 md:grid-cols-2 mt-3">
      <li :for="entry in watching()">
        <a :href="entry.href" class="block p-5 h-full bg-surface hover:bg-tint border border-line rounded-2xl transition-colors">
          <p class="font-medium text-ink">{{ entry.title }}</p>
          <p class="mt-1 text-muted text-sm">{{ entry.nextTitle ? 'Next: ' + entry.nextTitle : '' }}</p>
          <div class="overflow-hidden mt-3 h-1.5 bg-tint rounded-full" role="progressbar" aria-valuemin="0" aria-valuemax="100" :aria-valuenow="entry.percent" :aria-label="'Progress in ' + entry.title">
            <div class="h-full bg-accent rounded-full" :style="`width: ${entry.percent}%`"></div>
          </div>
        </a>
      </li>
    </ul>
  </section>

  @if(cards.length === 0)
    <p class="mt-10 text-muted">Nothing is published here yet.</p>
  @else
    @if(topics.length > 1)
      <div class="flex flex-wrap gap-2 mt-10" role="group" aria-label="Topics">
        <button type="button" class="inline-flex items-center px-4 h-10 text-sm border rounded-full" :class="topic() === '' ? 'border-accent bg-accent-soft text-ink' : 'border-line text-muted'" :aria-pressed="topic() === ''" @click="topic.set('')">Everything</button>
        @foreach(topics as name)
          <button type="button" class="inline-flex items-center px-4 h-10 text-sm border rounded-full" :class="topic() === '{{ name }}' ? 'border-accent bg-accent-soft text-ink' : 'border-line text-muted'" :aria-pressed="topic() === '{{ name }}'" @click="pickTopic('{{ name }}')">{{ name }}</button>
        @endforeach
      </div>
    @endif

    <ul class="grid gap-4 grid-cols-1 md:grid-cols-2 mt-6">
      @foreach(cards as card)
        <li :hidden="topic() !== '' && topic() !== '{{ card.topic }}'">
          <a href="{{ card.href }}" class="flex flex-col p-6 h-full bg-surface hover:bg-tint border border-line rounded-2xl transition-colors">
            <p class="flex flex-wrap gap-x-3 gap-y-1 items-center min-h-5 text-xs">
              @if(card.topic)
                <span class="font-medium text-accent">{{ card.topic }}</span>
              @endif
              @if(card.levelText)
                <span class="text-muted">{{ card.levelText }}</span>
              @endif
              @if(card.hasPreview)
                <span class="px-2 py-0.5 font-medium text-accent bg-accent-soft rounded-full">Free preview</span>
              @endif
            </p>
            <h2 class="mt-3 font-semibold text-ink text-xl tracking-tight">{{ card.title }}</h2>
            @if(card.summary)
              <p class="flex-1 mt-2 leading-relaxed text-muted">{{ card.summary }}</p>
            @endif
            <p class="flex gap-3 mt-4 tabular-nums text-muted text-sm">
              <span>{{ card.count }}</span>
              @if(card.time)
                <span>{{ card.time }}</span>
              @endif
            </p>
          </a>
        </li>
      @endforeach
    </ul>
  @endif
@else
  <h1 class="font-semibold text-3xl text-ink tracking-tight">Academy not found</h1>
@endif
</div>
</template>
