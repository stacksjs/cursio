    <article class="md:col-span-6 p-6 md:p-8 bg-surface border border-line rounded-2xl">
      <span class="{{ cohorts.icon }} size-7 text-accent" aria-hidden="true"></span>
      <h3 class="mt-4 font-semibold text-ink text-xl tracking-tight">{{ cohorts.title }}</h3>
      <p class="mt-2 max-w-[48ch] leading-relaxed text-muted">{{ cohorts.summary }}</p>
      <p class="mt-6 text-muted text-sm">{{ cohorts.statusText }}</p>
