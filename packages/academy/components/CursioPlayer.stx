<script server>
import { learnBase, runtime, wordsOf } from '@cursio/academy'

// Props: `school` (the Academy), `course`, `outline`, `home` (where the
// catalog lives in this app), `path` (this page, for coming back after
// sign-in) and `api` (where the learner API answers: `/api/learn` on Cursio
// itself, `/api/cursio/learn` in an app that proxies to it).
const found = course
const academyHome = home || '/'
const returnPath = path || academyHome
const lessonTotal = outline.lessonIds.length
const learnApi = learnBase(api)
const apiPath = `${learnApi}/${school.slug}/courses/${course.slug}`

// What a screencast page needs from the outline, worked out once: the order
// Lessons are met in (an episode's number is its place in it), which may be
// watched without enrolling, and a clock face for each.
const words = wordsOf(school)
const lessonOrder = outline.lessonIds
const flat = outline.sections.flatMap(section => section.lessons)
const previewIds = flat.filter(lesson => lesson.is_preview).map(lesson => lesson.id)
const totalRuntime = runtime(flat.reduce((sum, lesson) => sum + lesson.duration_seconds, 0))
const levelText = found?.level ? found.level.charAt(0).toUpperCase() + found.level.slice(1) : ''
const rows = outline.sections.map(section => ({
  title: section.title,
  lessons: section.lessons.map(lesson => ({
    id: lesson.id,
    title: lesson.title,
    number: lessonOrder.indexOf(lesson.id) + 1,
    preview: Boolean(lesson.is_preview),
    clock: lesson.duration_seconds > 0 ? `${Math.floor(lesson.duration_seconds / 60)}:${String(lesson.duration_seconds % 60).padStart(2, '0')}` : '',
  })),
}))
</script>
<script client>
import { useAuth } from '~/storage/framework/defaults/functions/auth'
import { dashboardApi } from '~/storage/framework/defaults/functions/dashboard-api'

const coursePath = {{ apiPath }}
const learnApi = {{ learnApi }}
const total = {{ lessonTotal }}
const order = {{ lessonOrder }}
const previews = {{ previewIds }}
const speeds = [1, 1.25, 1.5, 2]

const speed = state(1)
// The <video> element, handed over by its own `loadedmetadata` event.
let player = null
let playNext = false
let savedAt = 0

const signedIn = state(false)
const enrolled = state(false)
const doneIds = state([])
const locked = state({})
const openLesson = state(null)
const busy = state(false)
const problem = state('')
const certificate = state('')

// The quiz behind the open Lesson, when it is one.
const quiz = state(null)
// The assignment behind the open Lesson, when it is one, with the Learner's own work.
const task = state(null)
let workBody = ''
let workLink = ''
const attempt = state(null)
const result = state(null)
const reviewed = state([])
const picks = state({})
// The Learner's arrangement of each ordering question: question id to option ids.
const orders = state({})
const remaining = state(-1)
// Typed answers are kept out of a signal so a keystroke redraws nothing.
let typed = {}
// Matching answers: question id to { position of the left item: chosen text }.
let matches = {}
let ticking = 0

const percent = derived(() => total === 0 ? 0 : Math.round((doneIds().length / total) * 100))
const finished = derived(() => total > 0 && doneIds().length === total)

function isDone(lessonId) {
  return doneIds().includes(lessonId)
}

function isLocked(lessonId) {
  return Boolean(locked()[lessonId])
}

function lockNote(lessonId) {
  const state = locked()[lessonId]
  if (!state)
    return ''
  if (state.reason === 'drip' && state.opensAt)
    return `Opens ${new Date(state.opensAt).toLocaleDateString(undefined, { month: 'short', day: 'numeric' })}`
  return 'After the earlier lessons'
}

function take(progress) {
  doneIds.set(progress?.completedIds ?? [])
  locked.set(progress?.locked ?? {})
}

async function load() {
  signedIn.set(Boolean(useAuth().getToken()))
  if (!signedIn())
    return
  try {
    const data = await dashboardApi(`${coursePath}/progress`)
    enrolled.set(data.enrolled)
    certificate.set(data.certificate || '')
    take(data.progress)
  }
  catch {
    // Signed-out or expired: the page still shows the public outline.
    signedIn.set(false)
  }
}

async function enrollNow() {
  busy.set(true)
  problem.set('')
  try {
    const data = await dashboardApi(`${coursePath}/enroll`, { method: 'POST', body: {} })
    enrolled.set(true)
    take(data.progress)
  }
  catch (error) {
    problem.set(error?.message || 'Enrollment did not go through.')
  }
  busy.set(false)
}

function canOpen(lessonId) {
  return enrolled() ? !isLocked(lessonId) : previews.includes(lessonId)
}

async function open(lessonId) {
  if (!canOpen(lessonId))
    return
  problem.set('')
  stopClock()
  quiz.set(null)
  task.set(null)
  attempt.set(null)
  result.set(null)
  try {
    // Not enrolled: only a free preview got this far, and it has its own door.
    const data = enrolled()
      ? await dashboardApi(`${learnApi}/lessons/${lessonId}`)
      : await fetch(`${learnApi}/lessons/${lessonId}/preview`, { headers: { Accept: 'application/json' } }).then(answer => answer.ok ? answer.json() : Promise.reject(new Error('This preview could not be opened.')))
    try {
      useSearchParams().set('episode', String(order.indexOf(lessonId) + 1))
    }
    catch {
      // The address is a convenience; the episode opens either way.
    }
    if (data.lesson.kind === 'assignment') {
      const brief = await dashboardApi(`${learnApi}/lessons/${lessonId}/assignment`)
      workBody = brief.assignment.submission?.body || ''
      workLink = brief.assignment.submission?.link || ''
      task.set(brief.assignment)
    }
    if (data.lesson.kind === 'quiz') {
      const sitting = await dashboardApi(`${learnApi}/lessons/${lessonId}/quiz`)
      quiz.set(sitting.quiz)
      if (sitting.quiz.open)
        begin(sitting.quiz.open)
    }
    openLesson.set(data.lesson)
  }
  catch (error) {
    problem.set(error?.message || 'This lesson could not be opened.')
  }
}

async function complete() {
  const lesson = openLesson()
  if (!lesson)
    return
  busy.set(true)
  try {
    const data = await dashboardApi(`${learnApi}/lessons/${lesson.id}/complete`, { method: 'POST', body: {} })
    take(data.progress)
    openLesson.set({ ...lesson, completed: true })
    if (data.courseCompleted) {
      await load()
    }
    else {
      // Carry on to the one after this, as a viewer expects; only when there
      // is none ahead go back to the first still unwatched.
      const ahead = order.slice(order.indexOf(lesson.id) + 1).find(id => !data.progress.completedIds.includes(id) && !data.progress.locked[id])
      const next = ahead || data.progress.nextLessonId
      if (next && !data.progress.locked[next])
        await open(next)
    }
  }
  catch (error) {
    problem.set(error?.message || 'That did not save.')
  }
  busy.set(false)
}

function stopClock() {
  if (ticking)
    clearInterval(ticking)
  ticking = 0
  remaining.set(-1)
}

function begin(opened) {
  typed = {}
  matches = {}
  picks.set({})
  orders.set(Object.fromEntries(opened.questions.filter(question => question.kind === 'ordering').map(question => [question.id, question.options.map(option => option.id)])))
  result.set(null)
  attempt.set(opened)
  stopClock()
  if (!opened.deadline)
    return
  const closes = new Date(opened.deadline).getTime()
  const tick = () => {
    const left = Math.max(0, Math.round((closes - Date.now()) / 1000))
    remaining.set(left)
    // Out of time: hand in what is there rather than lose it.
    if (left === 0 && attempt() && !busy())
      submitQuiz()
  }
  tick()
  ticking = setInterval(tick, 1000)
}

function clock() {
  const left = remaining()
  if (left < 0)
    return ''
  return `${Math.floor(left / 60)}:${String(left % 60).padStart(2, '0')}`
}

async function startQuiz() {
  const lesson = openLesson()
  if (!lesson)
    return
  busy.set(true)
  problem.set('')
  try {
    const data = await dashboardApi(`${learnApi}/lessons/${lesson.id}/quiz/attempts`, { method: 'POST', body: {} })
    begin(data.attempt)
  }
  catch (error) {
    problem.set(error?.message || 'The quiz could not be started.')
  }
  busy.set(false)
}

function isPicked(questionId, optionId) {
  return (picks()[questionId] || []).includes(optionId)
}

function pick(questionId, kind, optionId) {
  const chosen = picks()[questionId] || []
  const next = kind === 'multiple'
    ? (chosen.includes(optionId) ? chosen.filter(id => id !== optionId) : [...chosen, optionId])
    : [optionId]
  picks.set({ ...picks(), [questionId]: next })
}

function type(questionId, value) {
  typed[questionId] = value
}

function match(questionId, index, value) {
  matches[questionId] = { ...(matches[questionId] || {}), [index]: value }
}

/** An ordering question's items in the order the Learner has them now. */
function arranged(question) {
  const order = orders()[question.id] || []
  return order.map(id => question.options.find(option => option.id === id)).filter(Boolean)
}

function shift(questionId, optionId, step) {
  const order = [...(orders()[questionId] || [])]
  const from = order.indexOf(optionId)
  const to = from + step
  if (from < 0 || to < 0 || to >= order.length)
    return
  order.splice(to, 0, order.splice(from, 1)[0])
  orders.set({ ...orders(), [questionId]: order })
}

async function submitQuiz() {
  const sitting = attempt()
  if (!sitting)
    return
  busy.set(true)
  problem.set('')
  const answers = {}
  for (const question of sitting.questions) {
    if (question.kind === 'text' || question.kind === 'number' || question.kind === 'essay')
      answers[question.id] = typed[question.id] ?? ''
    else if (question.kind === 'ordering')
      answers[question.id] = orders()[question.id] || []
    else if (question.kind === 'matching')
      answers[question.id] = matches[question.id] || {}
    else
      answers[question.id] = picks()[question.id] || []
  }
  try {
    const data = await dashboardApi(`${learnApi}/attempts/${sitting.id}/submit`, { method: 'POST', body: { answers } })
    stopClock()
    const byId = Object.fromEntries(data.result.questions.map(item => [item.id, item]))
    reviewed.set(sitting.questions.map(question => ({ ...question, ...byId[question.id], right: rightAnswer(question, byId[question.id]) })))
    attempt.set(null)
    quiz.set(data.result.quiz)
    result.set(data.result)
    take(data.result.progress)
    if (data.result.passed)
      openLesson.set({ ...openLesson(), completed: true })
    if (data.result.courseCompleted)
      await load()
  }
  catch (error) {
    stopClock()
    attempt.set(null)
    problem.set(error?.message || 'Your answers could not be handed in.')
    const lesson = openLesson()
    if (lesson)
      await open(lesson.id)
  }
  busy.set(false)
}

/** The right answer in words, when the quiz reveals it. */
function rightAnswer(question, review) {
  if (!review || review.correctOptionIds === undefined)
    return ''
  if (question.kind === 'text')
    return review.accepted?.answers?.[0] || ''
  if (question.kind === 'number')
    return String(review.accepted?.value ?? '')
  if (question.kind === 'matching')
    return (review.accepted?.pairs || []).map(pair => `${pair.left} with ${pair.right}`).join(', ')
  if (question.kind === 'ordering')
    return review.correctOptionIds.map(id => question.options.find(option => option.id === id)?.label).join(', then ')
  return question.options.filter(option => review.correctOptionIds.includes(option.id)).map(option => option.label).join(', ')
}

function setWork(field, value) {
  if (field === 'body')
    workBody = value
  else
    workLink = value
}

async function handIn() {
  const lesson = openLesson()
  if (!lesson)
    return
  busy.set(true)
  problem.set('')
  try {
    const data = await dashboardApi(`${learnApi}/lessons/${lesson.id}/assignment/submit`, { method: 'POST', body: { body: workBody, link: workLink } })
    task.set({ ...task(), submission: data.submission })
  }
  catch (error) {
    problem.set(error?.message || 'Your work could not be handed in.')
  }
  busy.set(false)
}

function workStatus() {
  const work = task()?.submission
  if (!work)
    return ''
  if (work.status === 'passed')
    return `Passed with ${work.score} of ${task().maxPoints}`
  if (work.status === 'returned')
    return `Returned with ${work.score} of ${task().maxPoints}. You can hand it in again.`
  return 'Handed in. It is waiting to be marked.'
}

/** What a marker wrote back on the essay answers, newest attempt first. */
function markerNotes() {
  const attempts = quiz()?.attempts || []
  return [...attempts].reverse().flatMap(item => item.notes || [])
}

function attemptsNote() {
  const sitting = quiz()
  // Once passed, how many tries remain is no longer the Learner's concern.
  if (!sitting || sitting.attemptsLeft === null || sitting.passed)
    return ''
  return sitting.attemptsLeft === 1 ? '1 attempt left' : `${sitting.attemptsLeft} attempts left`
}

/** The video is ready: put it back where the Learner stopped, at their speed. */
function ready(video) {
  player = video
  video.playbackRate = speed()
  const lesson = openLesson()
  const from = lesson?.position_seconds || 0
  if (from > 5 && (!video.duration || from < video.duration - 10))
    video.currentTime = from
  if (playNext) {
    playNext = false
    video.play().catch(() => {})
  }
}

function setSpeed(value) {
  speed.set(value)
  if (player)
    player.playbackRate = value
}

/** Remember the position every ten seconds of watching. */
function watched(video) {
  const lesson = openLesson()
  if (!lesson || !enrolled() || Math.abs(video.currentTime - savedAt) < 10)
    return
  savedAt = video.currentTime
  dashboardApi(`${learnApi}/lessons/${lesson.id}/position`, { method: 'POST', body: { seconds: Math.round(video.currentTime) } }).catch(() => {})
}

/** The episode ran to its end: that completes it, and the next one starts. */
async function ended() {
  const lesson = openLesson()
  if (!lesson || !enrolled())
    return
  playNext = true
  if (lesson.completed) {
    const next = order[order.indexOf(lesson.id) + 1]
    if (next && canOpen(next))
      await open(next)
    return
  }
  await complete()
}

onMount(async () => {
  await load()
  const wanted = Number(useSearchParams().get('episode'))
  const lessonId = Number.isInteger(wanted) && wanted > 0 ? order[wanted - 1] : 0
  if (lessonId && canOpen(lessonId))
    await open(lessonId)
})
</script>
<template>
<div data-stx-content>
@if(found)
  <a href="{{ academyHome }}" class="text-muted text-sm hover:text-ink">{{ school.name }}</a>
  <h1 class="mt-3 font-semibold text-4xl text-ink tracking-tight">{{ found.title }}</h1>
  @if(found.summary)
    <p class="mt-3 max-w-[60ch] text-lg text-muted">{{ found.summary }}</p>
  @endif
  <p class="flex flex-wrap gap-x-4 gap-y-1 mt-4 text-muted text-sm">
    @if(found.topic)
      <span class="font-medium text-ink">{{ found.topic }}</span>
    @endif
    @if(levelText)
      <span>{{ levelText }}</span>
    @endif
    <span>{{ lessonTotal }} {{ lessonTotal === 1 ? words.lesson : words.lessons }}</span>
    @if(totalRuntime)
      <span>{{ totalRuntime }}</span>
    @endif
  </p>

  <div class="flex flex-wrap gap-3 items-center mt-6" :hidden="enrolled()">
    <a href="/login?redirect={{ returnPath }}" class="inline-flex items-center px-6 h-12 font-medium text-accent-ink bg-accent rounded-full" :hidden="signedIn()">Sign in to enroll</a>
    <button type="button" class="inline-flex items-center px-6 h-12 font-medium text-accent-ink bg-accent rounded-full disabled:opacity-60" :hidden="!signedIn()" hidden :disabled="busy()" @click="enrollNow()">Enroll for free</button>
  </div>

  <div class="mt-6" :hidden="!enrolled()" hidden>
    <p class="text-ink"><span class="font-semibold tabular-nums" x-text="percent()">0</span>% complete</p>
    <div class="overflow-hidden mt-2 h-1.5 bg-tint rounded-full" role="progressbar" aria-valuemin="0" aria-valuemax="100" :aria-valuenow="percent()" aria-label="Course progress">
      <div class="h-full bg-accent rounded-full duration-300 transition-all" :style="`width: ${percent()}%`"></div>
    </div>
    <p class="mt-3 font-medium text-ink" :hidden="!finished()" hidden role="status">You have completed this course.</p>
    <a :href="'/certificates/' + certificate()" class="inline-flex gap-2 items-center mt-3 px-5 h-11 font-medium text-ink hover:bg-tint border border-line rounded-full transition-colors" :hidden="!certificate()" hidden><span class="size-5 i-hugeicons-certificate-01" aria-hidden="true"></span>View your certificate</a>
  </div>

  <p class="mt-4 font-medium text-ink" :hidden="!problem()" hidden role="alert" x-text="problem()"></p>

  <div class="grid gap-8 grid-cols-1 lg:grid-cols-12 mt-10">
    <div class="flex flex-col gap-6 lg:col-span-5">
      @foreach(rows as section)
        <div>
          <h2 class="font-medium text-muted text-sm">{{ section.title }}</h2>
          <ul class="flex flex-col gap-1 mt-2">
            @foreach(section.lessons as lesson)
              <li>
                <button type="button" class="flex gap-3 items-center px-3 py-2.5 w-full text-left hover:bg-tint rounded-xl transition-colors" :class="openLesson()?.id === {{ lesson.id }} ? 'bg-tint' : ''" @click="open({{ lesson.id }})">
                  <span class="shrink-0 size-5" :class="isDone({{ lesson.id }}) ? 'i-hugeicons-checkmark-circle-02 text-accent' : (isLocked({{ lesson.id }}) ? 'i-hugeicons-square-lock-02 text-muted' : 'i-hugeicons-circle text-muted')" aria-hidden="true"></span>
                  <span class="w-5 tabular-nums text-muted text-xs">{{ lesson.number }}</span>
                  <span class="flex-1 text-sm" :class="isLocked({{ lesson.id }}) ? 'text-muted' : 'text-ink'">{{ lesson.title }}</span>
                  @if(lesson.preview)
                    <span class="px-2 py-0.5 font-medium text-accent text-xs bg-accent-soft rounded-full" :hidden="enrolled()">Free</span>
                  @endif
                  <span class="text-muted text-xs" x-text="lockNote({{ lesson.id }})"></span>
                  <span class="tabular-nums text-muted text-xs">{{ lesson.clock }}</span>
                </button>
              </li>
            @endforeach
          </ul>
        </div>
      @endforeach
    </div>

    <div class="lg:col-span-7">
      <p class="p-6 text-muted bg-tint rounded-2xl" :hidden="openLesson() !== null">{{ enrolled() ? 'Pick one to begin.' : (previews.length > 0 ? 'Watch a free one, or enroll to open them all.' : 'Enroll to open them.') }}</p>
      <article class="p-6 bg-surface border border-line rounded-2xl" :hidden="openLesson() === null" hidden>
        <h2 class="font-semibold text-2xl text-ink tracking-tight">{{ openLesson()?.title }}</h2>
        <video class="aspect-video mt-4 w-full bg-black rounded-xl" controls playsinline preload="metadata" :hidden="!openLesson()?.video_url" hidden :src="openLesson()?.video_url || ''" @loadedmetadata="ready($event.target)" @timeupdate="watched($event.target)" @ended="ended()"></video>
        <div class="flex flex-wrap gap-2 items-center mt-3" :hidden="!openLesson()?.video_url" hidden role="group" aria-label="Playback speed">
          <span class="text-muted text-xs">Speed</span>
          <button :for="value in speeds" type="button" class="inline-flex items-center px-3 h-9 tabular-nums text-xs border rounded-full" :class="speed() === value ? 'border-accent bg-accent-soft text-ink' : 'border-line text-muted'" :aria-pressed="speed() === value" @click="setSpeed(value)">{{ value }}x</button>
        </div>
        <div class="mt-4 notes" x-html="openLesson()?.body_html || ''"></div>
        <p class="mt-6 p-4 text-ink text-sm bg-accent-soft rounded-xl" :hidden="enrolled() || openLesson() === null">This one is free. Enroll to watch the rest and keep your place.</p>
        <button type="button" class="inline-flex items-center mt-6 px-5 h-11 font-medium text-accent-ink bg-accent rounded-full disabled:opacity-60" :hidden="openLesson()?.kind === 'quiz' || openLesson()?.kind === 'assignment' || !enrolled()" :disabled="busy() || openLesson()?.completed" @click="complete()">{{ openLesson()?.completed ? 'Completed' : 'Mark complete' }}</button>

        <div class="mt-6 pt-6 border-line border-t" :hidden="task() === null" hidden>
          <p class="tabular-nums text-muted text-sm">{{ task()?.maxPoints }} points, {{ task()?.passPoints }} to pass</p>
          <ul class="flex flex-col gap-1 mt-3" :hidden="(task()?.rubric.length || 0) === 0">
            <li :for="(criterion, index) in task()?.rubric || []" class="flex gap-3 justify-between text-sm">
              <span class="text-ink">{{ criterion.title }}</span>
              <span class="tabular-nums text-muted">{{ task()?.submission?.rubric_scores[index] ?? '' }}{{ task()?.submission?.score === null || task()?.submission?.score === undefined ? '' : ' of ' }}{{ criterion.points }}</span>
            </li>
          </ul>

          <div class="mt-4 p-4 rounded-xl" :class="task()?.submission?.status === 'passed' ? 'bg-accent-soft' : 'bg-tint'" :hidden="!task()?.submission" role="status">
            <p class="font-medium text-ink" x-text="workStatus()"></p>
            <p class="mt-2 text-ink text-sm whitespace-pre-line" :hidden="!task()?.submission?.feedback">{{ task()?.submission?.feedback || '' }}</p>
          </div>

          <form class="mt-5" :hidden="!task()?.canSubmit || task()?.submission?.status === 'passed'" @submit.prevent="handIn()">
            <label for="work-body" class="block font-medium text-ink text-sm">Your answer</label>
            <textarea id="work-body" rows="8" class="mt-2 px-4 py-3 w-full text-ink bg-page border border-line rounded-xl" :value="task()?.submission?.body || ''" @input="setWork('body', $event.target.value)"></textarea>
            <label for="work-link" class="block mt-4 font-medium text-ink text-sm">Link to your work</label>
            <input id="work-link" type="url" aria-describedby="work-link-help" class="mt-2 px-4 h-11 w-full text-ink bg-page border border-line rounded-xl" :value="task()?.submission?.link || ''" @input="setWork('link', $event.target.value)">
            <p id="work-link-help" class="mt-2 text-muted text-sm">Optional. An https link to a repository, a document or a recording.</p>
            <button type="submit" class="inline-flex items-center mt-5 px-5 h-11 font-medium text-accent-ink bg-accent rounded-full disabled:opacity-60" :disabled="busy()">{{ task()?.submission ? 'Hand in again' : 'Hand in' }}</button>
          </form>
        </div>

        <div :hidden="quiz() === null" hidden>
          <div :hidden="attempt() !== null">
            <dl class="grid gap-4 grid-cols-3 mt-6 py-4 border-line border-y">
              <div>
                <dt class="text-muted text-xs">Questions</dt>
                <dd class="mt-1 font-semibold tabular-nums text-ink">{{ quiz()?.questionCount }}</dd>
              </div>
              <div>
                <dt class="text-muted text-xs">To pass</dt>
                <dd class="mt-1 font-semibold tabular-nums text-ink">{{ quiz()?.passPercent }}%</dd>
              </div>
              <div>
                <dt class="text-muted text-xs">Time</dt>
                <dd class="mt-1 font-semibold tabular-nums text-ink">{{ quiz()?.timeLimitSeconds ? Math.round(quiz().timeLimitSeconds / 60) + ' min' : 'No limit' }}</dd>
              </div>
            </dl>

            <div class="mt-6 p-5 rounded-2xl" :class="result()?.passed ? 'bg-accent-soft' : 'bg-tint'" :hidden="result() === null" hidden role="status">
              <p class="font-semibold text-2xl text-ink tracking-tight">{{ result()?.pending ? 'Handed in' : (result()?.passed ? 'Passed' : 'Not passed yet') }}</p>
              <p class="mt-1 text-ink" :hidden="result()?.pending"><span class="font-semibold tabular-nums">{{ result()?.percent }}%</span>, {{ result()?.score }} of {{ result()?.max }} points</p>
              <p class="mt-1 text-ink" :hidden="!result()?.pending">Your written answers are with your instructor. The result shows here once they are marked.</p>
            </div>

            <p class="mt-6 p-5 text-ink bg-tint rounded-2xl" :hidden="!quiz()?.waiting || result() !== null" hidden role="status">Your last attempt is waiting for a mark. The result shows here once your instructor has read it.</p>

            <ul class="flex flex-col gap-3 mt-4" :hidden="markerNotes().length === 0 || result() !== null">
              <li :for="note in markerNotes()" class="p-4 border border-line rounded-xl">
                <p class="text-ink text-sm">{{ note.prompt }}</p>
                <p class="mt-1 font-medium tabular-nums text-ink text-sm">{{ note.points }} of {{ note.max }} points</p>
                <p class="mt-1 text-muted text-sm whitespace-pre-line" :hidden="!note.feedback">{{ note.feedback || '' }}</p>
              </li>
            </ul>

            <ol class="flex flex-col gap-3 mt-4" :hidden="result() === null || result()?.pending" hidden>
              <li :for="item in reviewed()" class="flex gap-3 items-start">
                <span class="shrink-0 mt-0.5 size-5" :class="item.correct ? 'i-hugeicons-checkmark-circle-02 text-accent' : 'i-hugeicons-cancel-circle text-muted'" aria-hidden="true"></span>
                <div class="min-w-0">
                  <p class="text-ink text-sm">{{ item.prompt }} <span class="sr-only">{{ item.correct ? 'Correct' : 'Incorrect' }}</span></p>
                  <p class="mt-1 text-muted text-sm" :hidden="!item.right">Answer: {{ item.right }}</p>
                  <p class="mt-1 text-muted text-sm" :hidden="!item.explanation">{{ item.explanation }}</p>
                </div>
              </li>
            </ol>

            <div class="flex flex-wrap gap-4 items-center mt-6">
              <button type="button" class="inline-flex items-center px-5 h-11 font-medium text-accent-ink bg-accent rounded-full disabled:opacity-60" :hidden="quiz()?.attemptsLeft === 0 || quiz()?.waiting" :disabled="busy()" @click="startQuiz()">{{ (quiz()?.attempts.length || 0) > 0 ? 'Try again' : 'Start the quiz' }}</button>
              <p class="text-muted text-sm" x-text="attemptsNote()"></p>
              <p class="font-medium text-accent text-sm" :hidden="!quiz()?.passed" hidden>Passed</p>
            </div>
            <p class="mt-3 text-muted text-sm" :hidden="quiz()?.attemptsLeft !== 0 || quiz()?.passed" hidden>You have used every attempt. Ask your instructor to open another.</p>
          </div>

          <form class="mt-6" :hidden="attempt() === null" hidden @submit.prevent="submitQuiz()">
            <p class="inline-flex sticky top-20 z-10 gap-2 items-center px-4 h-10 font-medium tabular-nums text-ink text-sm bg-tint rounded-full" :hidden="remaining() < 0" hidden role="timer"><span class="size-4 i-hugeicons-timer-02" aria-hidden="true"></span><span x-text="clock()"></span></p>
            <ol class="flex flex-col gap-8 mt-4">
              <li :for="(question, index) in attempt()?.questions || []">
                <p class="font-medium text-ink"><span class="tabular-nums text-muted">{{ index + 1 }}.</span> {{ question.prompt }}</p>
                <p class="mt-1 text-muted text-xs" :hidden="question.kind !== 'multiple'">Pick every answer that applies.</p>
                <p class="mt-1 text-muted text-xs" :hidden="question.kind !== 'ordering'">Put these in order with the arrows.</p>
                <ol class="flex flex-col gap-2 mt-3" :hidden="question.kind !== 'ordering'">
                  <li :for="(option, place) in arranged(question)" class="flex gap-2 items-center px-4 py-2 text-sm border border-line rounded-xl">
                    <span class="w-5 tabular-nums text-muted">{{ place + 1 }}</span>
                    <span class="flex-1 text-ink">{{ option.label }}</span>
                    <button type="button" class="inline-flex items-center justify-center size-9 text-muted hover:text-ink rounded-full disabled:opacity-40" :aria-label="'Move ' + option.label + ' up'" :disabled="place === 0" @click="shift(question.id, option.id, -1)"><span class="size-4 i-hugeicons-arrow-up-01" aria-hidden="true"></span></button>
                    <button type="button" class="inline-flex items-center justify-center size-9 text-muted hover:text-ink rounded-full disabled:opacity-40" :aria-label="'Move ' + option.label + ' down'" :disabled="place === arranged(question).length - 1" @click="shift(question.id, option.id, 1)"><span class="size-4 i-hugeicons-arrow-down-01" aria-hidden="true"></span></button>
                  </li>
                </ol>
                <ul class="flex flex-col gap-2 mt-3" :hidden="question.kind !== 'matching'">
                  <li :for="(left, place) in question.lefts || []" class="grid gap-2 grid-cols-1 sm:grid-cols-2 sm:items-center">
                    <span class="text-ink text-sm">{{ left }}</span>
                    <select class="px-3 h-11 w-full text-ink bg-page border border-line rounded-xl" :aria-label="'Match for ' + left" @change="match(question.id, place, $event.target.value)">
                      <option value="">Choose</option>
                      <option :for="right in question.rights || []" :value="right">{{ right }}</option>
                    </select>
                  </li>
                </ul>
                <div class="flex flex-col gap-2 mt-3" :hidden="question.options.length === 0 || question.kind === 'ordering'">
                  <button :for="option in question.options" type="button" class="flex gap-3 items-center px-4 py-3 w-full text-left text-sm border rounded-xl transition-colors" :class="isPicked(question.id, option.id) ? 'border-accent bg-accent-soft text-ink' : 'border-line text-ink hover:bg-tint'" :aria-pressed="isPicked(question.id, option.id)" @click="pick(question.id, question.kind, option.id)">
                    <span class="shrink-0 size-5" :class="isPicked(question.id, option.id) ? 'i-hugeicons-checkmark-circle-02 text-accent' : 'i-hugeicons-circle text-muted'" aria-hidden="true"></span>
                    <span>{{ option.label }}</span>
                  </button>
                </div>
                <textarea :hidden="question.kind !== 'essay'" rows="7" maxlength="7000" class="mt-3 px-4 py-3 max-w-[70ch] w-full leading-relaxed text-ink bg-page border border-line rounded-xl" :aria-label="'Your answer to question ' + (index + 1)" @input="type(question.id, $event.target.value)"></textarea>
                <p class="mt-1 text-muted text-xs" :hidden="question.kind !== 'essay'">Your instructor reads and marks this answer.</p>
                <input :hidden="question.kind !== 'text' && question.kind !== 'number'" :type="question.kind === 'number' ? 'number' : 'text'" step="any" autocomplete="off" class="mt-3 px-4 h-11 max-w-sm w-full text-ink bg-page border border-line rounded-xl" :aria-label="'Your answer to question ' + (index + 1)" @input="type(question.id, $event.target.value)">
              </li>
            </ol>
            <button type="submit" class="inline-flex items-center mt-8 px-5 h-11 font-medium text-accent-ink bg-accent rounded-full disabled:opacity-60" :disabled="busy()">Hand in answers</button>
          </form>
        </div>
      </article>
    </div>
  </div>
@else
  <h1 class="font-semibold text-3xl text-ink tracking-tight">Course not found</h1>
@endif
</div>
</template>
