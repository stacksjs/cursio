<script client>
import { useAuth } from '~/storage/framework/defaults/functions/auth'

const signedIn = state(false)

onMount(() => {
  signedIn.set(Boolean(useAuth().getToken()))
})
</script>
<header class="sticky top-0 z-40 bg-page/85 border-b border-line backdrop-blur">
  <nav class="flex gap-6 items-center justify-between mx-auto px-4 md:px-8 h-16 max-w-5xl" aria-label="App">
    <a href="/" class="font-semibold text-ink text-xl tracking-tight">Cursio</a>
    <div class="flex gap-6 items-center text-sm">
      <a href="/studio" class="text-muted hover:text-ink transition-colors">Studio</a>
      <a href="/login" class="text-muted hover:text-ink transition-colors" :hidden="signedIn()">Sign in</a>
    </div>
  </nav>
</header>
