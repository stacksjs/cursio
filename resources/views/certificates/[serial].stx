@extends('layouts/app')
@section('content')
<script server>
import { certificateBySerial, publicCertificate } from '~/app/Support/certificates'

// Anyone holding a serial may check it. The page says what the Certificate
// itself says and nothing more about the Learner.
const given = typeof serial !== 'undefined' ? String(serial) : ''
const row = await certificateBySerial(given)
const found = row ? publicCertificate(row) : null

const pageTitle = found ? `${found.learnerName} - ${found.courseTitle}` : 'Certificate not found'
const pageDescription = found ? `Certificate of completion for ${found.courseTitle}, issued by ${found.academyName}.` : 'No certificate has this serial.'
</script>
<CursioCertificate :certificate="found" />
@endsection
