<script server>
/**
 * One real single-choice question, answerable on the page. The learner-facing
 * quiz is built from this same component.
 */
import { demoQuestion } from '~/resources/data/demo-course'

const question = demoQuestion
const correctId = question.correct
</script>
<script client>
const picked = state('')
const rightAnswer = {{ correctId }}

const answered = derived(() => picked() !== '')
const isRight = derived(() => picked() === rightAnswer)

function pick(id) {
  picked.set(id)
}
</script>
<div class="p-4 bg-surface border border-line rounded-2xl">
  <p class="font-medium text-ink text-sm">{{ question.prompt }}</p>
  <div class="flex flex-col gap-2 mt-3" role="radiogroup" aria-label="Answers">
    @foreach(question.options as option)
      <button type="button" role="radio" class="flex gap-3 items-center px-3 py-2 w-full font-mono text-left text-sm border rounded-xl transition-colors" :class="picked() === '{{ option.id }}' ? 'border-accent bg-accent-soft text-ink' : 'border-line text-muted hover:text-ink'" :aria-checked="picked() === '{{ option.id }}'" @click="pick('{{ option.id }}')">
        <span class="shrink-0 size-4" :class="picked() === '{{ option.id }}' ? 'i-hugeicons-radio-button text-accent' : 'i-hugeicons-circle'" aria-hidden="true"></span>
        {{ option.label }}
      </button>
    @endforeach
  </div>
  <p class="mt-3 text-muted text-sm" :hidden="!answered()" hidden aria-live="polite">
    <span class="font-medium text-ink" x-text="isRight() ? 'Correct.' : 'Not quite.'"></span>
    {{ question.explanation }}
  </p>
</div>
