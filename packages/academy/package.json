{
  "name": "@cursio/academy",
  "type": "module",
  "version": "0.1.1",
  "description": "Run a Cursio academy inside your own Stacks app: the catalog, the player and sign-in as stx components, and a typed client.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stacksjs/cursio.git",
    "directory": "packages/academy"
  },
  "keywords": [
    "cursio",
    "lms",
    "stacks",
    "stx",
    "courses"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "src",
    "components",
    "routes",
    "styles",
    "README.md",
    "LICENSE.md"
  ],
  "stacks": {
    "name": "cursio-academy",
    "description": "A Cursio academy inside a Stacks app",
    "components": [
      "components"
    ],
    "routes": [
      "routes/cursio.ts"
    ],
    "routePrefix": "/api/cursio"
  },
  "author": "Chris Breuer <chris@stacksjs.com>",
  "homepage": "https://cursio.org",
  "bugs": {
    "url": "https://github.com/stacksjs/cursio/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@stacksjs/env": ">=0.75.0",
    "@stacksjs/router": ">=0.75.0"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "peerDependenciesMeta": {
    "@stacksjs/env": {
      "optional": true
    },
    "@stacksjs/router": {
      "optional": true
    }
  }
}
