@extends('layouts/app')
@section('content')
<script server>
const pageTitle = 'Studio - Cursio'
const canonicalPath = '/studio'
</script>
<script client>
import { useAuth } from '~/storage/framework/defaults/functions/auth'
import { dashboardApi } from '~/storage/framework/defaults/functions/dashboard-api'

const loading = state(true)
const signedIn = state(true)
const academy = state(null)
// Every Academy this account runs; most people have one.
const academies = state([])
const courses = state([])
const problem = state('')
const busy = state(false)

const academyName = state('')
const academySlug = state('')
const courseTitle = state('')
const bankList = state([])
const newBankTitle = state('')

async function load() {
  if (!useAuth().getToken()) {
    signedIn.set(false)
    loading.set(false)
    return
  }
  try {
    // `?academy=12` picks which one to show; without it, the first.
    const wanted = Number(useSearchParams().get('academy')) || 0
    const data = await dashboardApi(wanted ? `/api/studio?academy_id=${wanted}` : '/api/studio')
    academy.set(data.academy)
    academies.set(data.academies || [])
    courses.set(data.courses)
    bankList.set(data.banks || [])
  }
  catch (error) {
    if (error?.status === 401)
      signedIn.set(false)
    else
      problem.set(error?.message || 'The studio could not be loaded.')
  }
  loading.set(false)
}

async function createBank() {
  busy.set(true)
  problem.set('')
  try {
    const data = await dashboardApi('/api/studio/banks', { method: 'POST', body: { title: newBankTitle(), academy_id: academy().id } })
    navigate(`/studio/banks/${data.bank.id}`)
  }
  catch (error) {
    problem.set(error?.message || 'The bank could not be created.')
    busy.set(false)
  }
}

function bankLine(bank) {
  const questions = `${bank.questions} ${bank.questions === 1 ? 'question' : 'questions'}`
  return bank.quizzes > 0 ? `${questions}, drawn by ${bank.quizzes} ${bank.quizzes === 1 ? 'quiz' : 'quizzes'}` : questions
}

async function openAcademy() {
  busy.set(true)
  problem.set('')
  try {
    await dashboardApi('/api/studio/academies', { method: 'POST', body: { name: academyName(), slug: academySlug() || undefined } })
    await load()
  }
  catch (error) {
    problem.set(error?.message || 'The academy could not be created.')
  }
  busy.set(false)
}

async function setVocabulary(value) {
  busy.set(true)
  problem.set('')
  try {
    const data = await dashboardApi('/api/studio/academy', { method: 'PATCH', body: { vocabulary: value, academy_id: academy().id } })
    academy.set(data.academy)
  }
  catch (error) {
    problem.set(error?.message || 'That did not save.')
  }
  busy.set(false)
}

async function createCourse() {
  busy.set(true)
  problem.set('')
  try {
    const data = await dashboardApi('/api/studio/courses', { method: 'POST', body: { title: courseTitle(), academy_id: academy().id } })
    navigate(`/studio/courses/${data.course.id}`)
  }
  catch (error) {
    problem.set(error?.message || 'The course could not be created.')
  }
  busy.set(false)
}

onMount(load)
</script>
<template>
<div data-stx-content>
  <h1 class="font-semibold text-3xl text-ink tracking-tight">Studio</h1>

  <p class="mt-6 text-muted" :hidden="!loading()">Loading your academy.</p>

  <div class="mt-6 p-6 bg-surface border border-line rounded-2xl" :hidden="loading() || signedIn()" hidden>
    <p class="text-ink">Sign in to build your academy.</p>
    <div class="flex flex-wrap gap-3 mt-4">
      <a href="/login?redirect=/studio" class="inline-flex items-center px-5 h-11 font-medium text-accent-ink bg-accent rounded-full">Sign in</a>
      <a href="/register?redirect=/studio" class="inline-flex items-center px-5 h-11 font-medium text-ink border border-line rounded-full">Create an account</a>
    </div>
  </div>

  <p class="mt-6 font-medium text-ink" :hidden="!problem()" hidden role="alert" x-text="problem()"></p>

  <form class="mt-6 p-6 bg-surface border border-line rounded-2xl" :hidden="loading() || !signedIn() || academy() !== null" hidden @submit.prevent="openAcademy()">
    <h2 class="font-semibold text-ink text-xl tracking-tight">Open your academy</h2>
    <div class="grid gap-4 grid-cols-1 md:grid-cols-2 mt-5">
      <div>
        <label for="academy-name" class="block font-medium text-ink text-sm">Name</label>
        <input id="academy-name" x-model.trim="academyName" type="text" required class="mt-2 px-4 h-11 w-full text-ink bg-surface border border-line rounded-xl">
      </div>
      <div>
        <label for="academy-slug" class="block font-medium text-ink text-sm">Address</label>
        <input id="academy-slug" x-model.trim="academySlug" type="text" aria-describedby="academy-slug-help" class="mt-2 px-4 h-11 w-full font-mono text-ink bg-surface border border-line rounded-xl">
        <p id="academy-slug-help" class="mt-2 text-muted text-sm">Lowercase letters, numbers and hyphens. Leave empty to use the name.</p>
      </div>
    </div>
    <button type="submit" class="inline-flex items-center mt-6 px-5 h-11 font-medium text-accent-ink bg-accent rounded-full disabled:opacity-60" :disabled="busy()">Open academy</button>
  </form>

  <div :hidden="academy() === null" hidden>
    <p class="mt-2 text-muted">{{ academy()?.name }} <span class="font-mono text-sm">/a/{{ academy()?.slug }}</span></p>

    <nav class="flex flex-wrap gap-2 mt-4" :hidden="academies().length < 2" aria-label="Your academies">
      <a :for="item in academies()" :href="'/studio?academy=' + item.id" class="inline-flex items-center px-4 h-10 text-sm border rounded-full" :class="item.id === academy()?.id ? 'border-accent bg-accent-soft text-ink' : 'border-line text-muted hover:text-ink'" :aria-current="item.id === academy()?.id ? 'page' : 'false'">{{ item.name }}</a>
    </nav>

    <fieldset class="mt-6">
      <legend class="font-medium text-ink text-sm">What learners see them called</legend>
      <div class="flex flex-wrap gap-2 mt-2">
        <button type="button" class="inline-flex items-center px-4 h-10 text-sm border rounded-full" :class="academy()?.vocabulary !== 'series' ? 'border-accent bg-accent-soft text-ink' : 'border-line text-muted'" :aria-pressed="academy()?.vocabulary !== 'series'" :disabled="busy()" @click="setVocabulary('course')">Courses and lessons</button>
        <button type="button" class="inline-flex items-center px-4 h-10 text-sm border rounded-full" :class="academy()?.vocabulary === 'series' ? 'border-accent bg-accent-soft text-ink' : 'border-line text-muted'" :aria-pressed="academy()?.vocabulary === 'series'" :disabled="busy()" @click="setVocabulary('series')">Series and episodes</button>
      </div>
    </fieldset>

    <form class="flex flex-col gap-3 sm:flex-row sm:items-end mt-8" @submit.prevent="createCourse()">
      <div class="flex-1">
        <label for="course-title" class="block font-medium text-ink text-sm">New course</label>
        <input id="course-title" x-model.trim="courseTitle" type="text" required class="mt-2 px-4 h-11 w-full text-ink bg-surface border border-line rounded-xl">
      </div>
      <button type="submit" class="inline-flex items-center justify-center px-5 h-11 font-medium text-accent-ink whitespace-nowrap bg-accent rounded-full disabled:opacity-60" :disabled="busy()">Create course</button>
    </form>

    <p class="mt-8 text-muted" :hidden="courses().length > 0">No courses yet. Name your first one above.</p>

    <ul class="flex flex-col gap-3 mt-8">
      <li :for="course in courses()">
        <a :href="`/studio/courses/${course.id}`" class="flex gap-4 items-center justify-between p-5 bg-surface hover:bg-tint border border-line rounded-2xl transition-colors">
          <span class="font-medium text-ink">{{ course.title }}</span>
          <span class="text-muted text-sm">{{ course.status === 'published' ? 'Published' : 'Draft' }}</span>
        </a>
      </li>
    </ul>

    <section class="mt-14" aria-labelledby="banks-heading">
      <h2 id="banks-heading" class="font-semibold text-ink text-xl tracking-tight">Question banks</h2>
      <p class="mt-1 max-w-[65ch] text-muted text-sm">Questions kept apart from any one quiz. A quiz that draws from a bank asks each attempt a different handful.</p>
      <ul class="flex flex-col gap-3 mt-5">
        <li :for="bank in bankList()">
          <a :href="`/studio/banks/${bank.id}`" class="flex gap-4 items-center justify-between p-5 bg-surface hover:bg-tint border border-line rounded-2xl transition-colors">
            <span class="font-medium text-ink">{{ bank.title }}</span>
            <span class="text-muted text-sm">{{ bankLine(bank) }}</span>
          </a>
        </li>
      </ul>
      <form class="flex flex-col gap-3 sm:flex-row sm:items-end mt-5" @submit.prevent="createBank()">
        <div class="flex-1">
          <label for="new-bank-title" class="block font-medium text-ink text-sm">New question bank</label>
          <input id="new-bank-title" x-model.trim="newBankTitle" type="text" required minlength="2" maxlength="120" class="mt-2 px-4 h-11 w-full text-ink bg-surface border border-line rounded-xl">
        </div>
        <button type="submit" class="inline-flex items-center justify-center px-5 h-11 font-medium text-ink whitespace-nowrap border border-line rounded-full disabled:opacity-60" :disabled="busy()">Create bank</button>
      </form>
    </section>
  </div>
</div>
</template>
@endsection
