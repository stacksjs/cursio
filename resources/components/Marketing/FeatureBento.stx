        <QuizPreview />
      </div>
      <p class="mt-5 text-muted text-sm">{{ quizzes.statusText }}</p>
    </article>

    <article class="md:col-span-4 p-6 md:p-8 text-accent-ink bg-accent rounded-2xl">
      <span class="{{ video.icon }} size-7" aria-hidden="true"></span>
      <h3 class="mt-4 font-semibold text-xl tracking-tight">{{ video.title }}</h3>
      <p class="mt-2 leading-relaxed">{{ video.summary }}</p>
      <p class="mt-6 text-sm">{{ video.statusText }}</p>
    </article>

    <article class="md:col-span-8 p-6 md:p-8 bg-surface border border-line rounded-2xl">
      <span class="{{ checkout.icon }} size-7 text-accent" aria-hidden="true"></span>
      <h3 class="mt-4 font-semibold text-ink text-xl tracking-tight">{{ checkout.title }}</h3>
      <p class="mt-2 max-w-[56ch] leading-relaxed text-muted">{{ checkout.summary }}</p>
      <ul class="flex flex-wrap gap-2 mt-6">
        @foreach(priceKinds as kind)
          <li class="inline-flex items-center px-3 h-9 text-ink text-sm bg-accent-soft rounded-full">{{ kind }}</li>
        @endforeach
      </ul>
      <p class="mt-6 text-muted text-sm">{{ checkout.statusText }}</p>
