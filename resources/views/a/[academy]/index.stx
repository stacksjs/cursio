@extends('layouts/app')
@section('content')
<script server>
import { academyBySlug } from '~/app/Support/academies'
import { publishedCourses } from '~/app/Support/courses'

const slug = typeof academy !== 'undefined' ? String(academy) : ''
const school = slug ? await academyBySlug(slug) : null
if (!school)
  notFound()

const courses = school ? await publishedCourses(school.id) : []
const pageTitle = school ? `${school.name} - Cursio` : 'Academy not found'
const pageDescription = school?.tagline || (school ? `Courses from ${school.name}.` : '')
const canonicalPath = `/a/${slug}`
</script>
@if(school)
  <h1 class="font-semibold text-4xl text-ink tracking-tight">{{ school.name }}</h1>
  @if(school.tagline)
    <p class="mt-3 max-w-[60ch] text-lg text-muted">{{ school.tagline }}</p>
  @endif

  @if(courses.length === 0)
    <p class="mt-10 text-muted">This academy has not published a course yet.</p>
  @else
    <ul class="grid gap-4 grid-cols-1 md:grid-cols-2 mt-10">
      @foreach(courses as course)
        <li>
          <a href="/a/{{ school.slug }}/{{ course.slug }}" class="block p-6 h-full bg-surface hover:bg-tint border border-line rounded-2xl transition-colors">
            <h2 class="font-semibold text-ink text-xl tracking-tight">{{ course.title }}</h2>
            @if(course.summary)
              <p class="mt-2 leading-relaxed text-muted">{{ course.summary }}</p>
            @endif
          </a>
        </li>
      @endforeach
    </ul>
  @endif
@else
  <h1 class="font-semibold text-3xl text-ink tracking-tight">Academy not found</h1>
@endif
@endsection
