@extends('layouts/app')
@section('content')
<script server>
const pageTitle = 'Quiz - Cursio Studio'
const courseId = typeof id !== 'undefined' ? Number(id) : 0
const lessonId = typeof lesson !== 'undefined' ? Number(lesson) : 0
</script>
<script client>
import { dashboardApi } from '~/storage/framework/defaults/functions/dashboard-api'

const courseHome = `/studio/courses/{{ courseId }}`
const base = `/api/studio/courses/{{ courseId }}/lessons/{{ lessonId }}/quiz`

const kindLabels = { single: 'One answer', multiple: 'Several answers', true_false: 'True or false', text: 'Typed answer', number: 'Number' }

const loading = state(true)
const loaded = state(false)
const problem = state('')
const busy = state(false)
const saved = state('')
const pendingDelete = state(0)
const questions = state([])

const passPercent = state('70')
const maxAttempts = state('')
const limitMinutes = state('')
const shuffle = state(false)
const reveal = state('after_submit')

const editing = state(0)
const kind = state('single')
const prompt = state('')
const explanation = state('')
const points = state('1')
const truth = state('true')
const typedAnswers = state('')
const numberValue = state('')
const numberMargin = state('')
// What is typed into the answer rows lives in `rows`, a plain list, so that a
// keystroke does not redraw the row being typed in. `options` is redrawn from
// it only when a row is added, removed or marked.
let rows = []
const options = state([])

const totalPoints = derived(() => questions().reduce((sum, question) => sum + question.points, 0))

function drawOptions() {
  options.set(rows.map(row => ({ ...row })))
}

function blankRows() {
  rows = [{ label: '', correct: true }, { label: '', correct: false }, { label: '', correct: false }]
  drawOptions()
}

function describeAnswer(question) {
  if (question.kind === 'text')
    return (question.accepted?.answers || []).join(', ')
  if (question.kind === 'number')
    return question.accepted?.tolerance ? `${question.accepted.value}, give or take ${question.accepted.tolerance}` : String(question.accepted?.value ?? '')
  return question.options.filter(option => option.is_correct).map(option => option.label).join(', ')
}

async function load() {
  try {
    const data = await dashboardApi(base)
    questions.set(data.questions)
    passPercent.set(String(data.quiz.pass_percent))
    maxAttempts.set(data.quiz.max_attempts ? String(data.quiz.max_attempts) : '')
    limitMinutes.set(data.quiz.time_limit_seconds ? String(Math.round(data.quiz.time_limit_seconds / 60)) : '')
    shuffle.set(Boolean(data.quiz.shuffle))
    reveal.set(data.quiz.reveal)
    loaded.set(true)
  }
  catch (error) {
    problem.set(error?.status === 401 ? 'Sign in to edit this quiz.' : (error?.message || 'This quiz could not be loaded.'))
  }
  loading.set(false)
}

async function send(method, path, body) {
  busy.set(true)
  problem.set('')
  saved.set('')
  pendingDelete.set(0)
  try {
    await dashboardApi(`${base}${path}`, { method, body })
    await load()
    return true
  }
  catch (error) {
    problem.set(error?.message || 'That did not save.')
    return false
  }
  finally {
    busy.set(false)
  }
}

async function saveSettings() {
  const done = await send('PATCH', '', {
    pass_percent: Number(passPercent()),
    max_attempts: Number(maxAttempts()) || 0,
    time_limit_seconds: (Number(limitMinutes()) || 0) * 60,
    shuffle: shuffle(),
    reveal: reveal(),
  })
  if (done)
    saved.set('Settings saved.')
}

function clearForm() {
  editing.set(0)
  kind.set('single')
  prompt.set('')
  explanation.set('')
  points.set('1')
  truth.set('true')
  typedAnswers.set('')
  numberValue.set('')
  numberMargin.set('')
  blankRows()
}

function edit(questionId) {
  const question = questions().find(item => item.id === questionId)
  if (!question)
    return
  editing.set(question.id)
  kind.set(question.kind)
  prompt.set(question.prompt)
  explanation.set(question.explanation || '')
  points.set(String(question.points))
  typedAnswers.set((question.accepted?.answers || []).join('\n'))
  numberValue.set(question.kind === 'number' ? String(question.accepted?.value ?? '') : '')
  numberMargin.set(question.accepted?.tolerance ? String(question.accepted.tolerance) : '')
  if (question.kind === 'true_false') {
    truth.set(question.options.find(option => option.is_correct)?.label === 'False' ? 'false' : 'true')
    blankRows()
  }
  else if (question.kind === 'single' || question.kind === 'multiple') {
    rows = question.options.map(option => ({ label: option.label, correct: option.is_correct }))
    drawOptions()
  }
  else {
    blankRows()
  }
}

function setLabel(index, value) {
  if (rows[index])
    rows[index].label = value
}

function mark(index) {
  // One answer: marking a row unmarks the rest. Several: each row toggles.
  rows = rows.map((row, at) => kind() === 'single'
    ? { ...row, correct: at === index }
    : (at === index ? { ...row, correct: !row.correct } : row))
  drawOptions()
}

function addRow() {
  if (rows.length < 12) {
    rows.push({ label: '', correct: false })
    drawOptions()
  }
}

function removeRow(index) {
  if (rows.length > 2) {
    rows.splice(index, 1)
    drawOptions()
  }
}

function setKind(value) {
  kind.set(value)
  // Going from several right answers to one: keep the first that was marked.
  if (value === 'single') {
    const first = rows.findIndex(row => row.correct)
    rows = rows.map((row, at) => ({ ...row, correct: at === (first < 0 ? 0 : first) }))
    drawOptions()
  }
}

async function saveQuestion() {
  const body = {
    kind: kind(),
    prompt: prompt(),
    explanation: explanation(),
    points: Number(points()) || 1,
    options: kind() === 'true_false'
      ? [{ label: 'True', correct: truth() === 'true' }, { label: 'False', correct: truth() === 'false' }]
      : rows,
    answers: typedAnswers().split('\n'),
    value: numberValue(),
    tolerance: Number(numberMargin()) || 0,
  }
  const done = editing()
    ? await send('PATCH', `/questions/${editing()}`, body)
    : await send('POST', '/questions', body)
  if (done)
    clearForm()
}

function move(questionId, step) {
  const ids = questions().map(question => question.id)
  const from = ids.indexOf(questionId)
  const to = from + step
  if (from < 0 || to < 0 || to >= ids.length)
    return
  ids.splice(to, 0, ids.splice(from, 1)[0])
  send('POST', '/reorder', { questions: ids })
}

function remove(questionId) {
  if (pendingDelete() !== questionId) {
    pendingDelete.set(questionId)
    return
  }
  send('DELETE', `/questions/${questionId}`)
}

onMount(() => {
  blankRows()
  load()
})
</script>
<template>
<div data-stx-content>
  <a :href="courseHome" class="text-muted text-sm hover:text-ink">Back to the course</a>

  <p class="mt-6 text-muted" :hidden="!loading()">Loading the quiz.</p>
  <p class="mt-6 font-medium text-ink" :hidden="!problem()" hidden role="alert" x-text="problem()"></p>

  <div :hidden="!loaded()" hidden>
    <h1 class="mt-4 font-semibold text-3xl text-ink tracking-tight">Quiz questions</h1>
    <p class="mt-1 text-muted text-sm">{{ questions().length }} {{ questions().length === 1 ? 'question' : 'questions' }}, {{ totalPoints() }} {{ totalPoints() === 1 ? 'point' : 'points' }}</p>

    <ol class="flex flex-col gap-3 mt-8">
      <li :for="question in questions()" class="p-5 bg-surface border border-line rounded-2xl" :class="editing() === question.id ? 'border-accent' : ''">
        <div class="flex flex-wrap gap-2 items-start justify-between">
          <div class="flex-1 min-w-0">
            <p class="text-muted text-xs">{{ kindLabels[question.kind] }}, {{ question.points }} {{ question.points === 1 ? 'point' : 'points' }}</p>
            <p class="mt-1 font-medium text-ink">{{ question.prompt }}</p>
            <p class="mt-1 text-muted text-sm">Answer: {{ describeAnswer(question) }}</p>
          </div>
          <div class="flex gap-1 items-center">
            <button type="button" class="inline-flex items-center justify-center size-9 text-muted hover:text-ink rounded-full" aria-label="Move question up" :disabled="busy()" @click="move(question.id, -1)"><span class="size-4 i-hugeicons-arrow-up-01" aria-hidden="true"></span></button>
            <button type="button" class="inline-flex items-center justify-center size-9 text-muted hover:text-ink rounded-full" aria-label="Move question down" :disabled="busy()" @click="move(question.id, 1)"><span class="size-4 i-hugeicons-arrow-down-01" aria-hidden="true"></span></button>
            <button type="button" class="inline-flex items-center px-3 h-9 text-muted text-sm hover:text-ink rounded-full" @click="edit(question.id)">Edit</button>
            <button type="button" class="inline-flex items-center px-3 h-9 text-muted text-sm hover:text-ink rounded-full" :disabled="busy()" @click="remove(question.id)">{{ pendingDelete() === question.id ? 'Really delete?' : 'Delete' }}</button>
          </div>
        </div>
      </li>
    </ol>
    <p class="p-5 text-muted bg-tint rounded-2xl" :hidden="questions().length > 0">No questions yet. A course cannot be published while one of its quizzes is empty.</p>

    <form class="mt-8 p-6 bg-tint rounded-2xl" @submit.prevent="saveQuestion()">
      <h2 class="font-semibold text-ink text-xl tracking-tight">{{ editing() ? 'Edit question' : 'New question' }}</h2>

      <fieldset class="mt-5">
        <legend class="font-medium text-ink text-sm">Type</legend>
        <div class="flex flex-wrap gap-2 mt-2">
          <button type="button" class="inline-flex items-center px-4 h-10 text-sm border rounded-full" :class="kind() === 'single' ? 'border-accent bg-accent-soft text-ink' : 'border-line bg-surface text-muted'" :aria-pressed="kind() === 'single'" @click="setKind('single')">One answer</button>
          <button type="button" class="inline-flex items-center px-4 h-10 text-sm border rounded-full" :class="kind() === 'multiple' ? 'border-accent bg-accent-soft text-ink' : 'border-line bg-surface text-muted'" :aria-pressed="kind() === 'multiple'" @click="setKind('multiple')">Several answers</button>
          <button type="button" class="inline-flex items-center px-4 h-10 text-sm border rounded-full" :class="kind() === 'true_false' ? 'border-accent bg-accent-soft text-ink' : 'border-line bg-surface text-muted'" :aria-pressed="kind() === 'true_false'" @click="setKind('true_false')">True or false</button>
          <button type="button" class="inline-flex items-center px-4 h-10 text-sm border rounded-full" :class="kind() === 'text' ? 'border-accent bg-accent-soft text-ink' : 'border-line bg-surface text-muted'" :aria-pressed="kind() === 'text'" @click="setKind('text')">Typed answer</button>
          <button type="button" class="inline-flex items-center px-4 h-10 text-sm border rounded-full" :class="kind() === 'number' ? 'border-accent bg-accent-soft text-ink' : 'border-line bg-surface text-muted'" :aria-pressed="kind() === 'number'" @click="setKind('number')">Number</button>
        </div>
      </fieldset>

      <div class="mt-4">
        <label for="question-prompt" class="block font-medium text-ink text-sm">Question</label>
        <textarea id="question-prompt" x-model="prompt" rows="2" required class="mt-2 px-4 py-3 w-full text-ink bg-surface border border-line rounded-xl"></textarea>
      </div>

      <fieldset class="mt-4" :hidden="kind() !== 'single' && kind() !== 'multiple'">
        <legend class="font-medium text-ink text-sm">Answers</legend>
        <p class="mt-1 text-muted text-sm">{{ kind() === 'single' ? 'Mark the one that is correct.' : 'Mark every one that is correct. A learner must pick exactly those.' }}</p>
        <ul class="flex flex-col gap-2 mt-3">
          <li :for="(option, index) in options()" class="flex gap-2 items-center">
            <button type="button" class="inline-flex items-center justify-center shrink-0 size-11 border rounded-xl" :class="option.correct ? 'border-accent bg-accent text-accent-ink' : 'border-line bg-surface text-muted'" :aria-pressed="option.correct" :aria-label="'Answer ' + (index + 1) + ' is correct'" @click="mark(index)"><span class="size-5 i-hugeicons-checkmark-circle-02" aria-hidden="true"></span></button>
            <input type="text" class="flex-1 px-4 h-11 min-w-0 text-ink bg-surface border border-line rounded-xl" :aria-label="'Answer ' + (index + 1)" :value="option.label" @input="setLabel(index, $event.target.value)">
            <button type="button" class="inline-flex items-center justify-center shrink-0 size-11 text-muted hover:text-ink rounded-full" :aria-label="'Remove answer ' + (index + 1)" :disabled="options().length <= 2" @click="removeRow(index)"><span class="size-4 i-hugeicons-delete-02" aria-hidden="true"></span></button>
          </li>
        </ul>
        <button type="button" class="inline-flex items-center mt-3 px-4 h-10 text-ink text-sm border border-line rounded-full" :hidden="options().length >= 12" @click="addRow()">Add an answer</button>
      </fieldset>

      <fieldset class="mt-4" :hidden="kind() !== 'true_false'" hidden>
        <legend class="font-medium text-ink text-sm">The statement is</legend>
        <div class="flex gap-2 mt-2">
          <button type="button" class="inline-flex items-center px-5 h-11 text-sm border rounded-full" :class="truth() === 'true' ? 'border-accent bg-accent-soft text-ink' : 'border-line bg-surface text-muted'" :aria-pressed="truth() === 'true'" @click="truth.set('true')">True</button>
          <button type="button" class="inline-flex items-center px-5 h-11 text-sm border rounded-full" :class="truth() === 'false' ? 'border-accent bg-accent-soft text-ink' : 'border-line bg-surface text-muted'" :aria-pressed="truth() === 'false'" @click="truth.set('false')">False</button>
        </div>
      </fieldset>

      <div class="mt-4" :hidden="kind() !== 'text'" hidden>
        <label for="question-answers" class="block font-medium text-ink text-sm">Accepted answers</label>
        <textarea id="question-answers" x-model="typedAnswers" rows="3" aria-describedby="question-answers-help" class="mt-2 px-4 py-3 w-full text-ink bg-surface border border-line rounded-xl"></textarea>
        <p id="question-answers-help" class="mt-2 text-muted text-sm">One per line. Capital letters and extra spaces do not matter.</p>
      </div>

      <div class="grid gap-4 grid-cols-1 sm:grid-cols-2 mt-4 max-w-md" :hidden="kind() !== 'number'" hidden>
        <div>
          <label for="question-value" class="block font-medium text-ink text-sm">Correct number</label>
          <input id="question-value" x-model="numberValue" type="number" step="any" class="mt-2 px-4 h-11 w-full text-ink bg-surface border border-line rounded-xl">
        </div>
        <div>
          <label for="question-margin" class="block font-medium text-ink text-sm">Give or take</label>
          <input id="question-margin" x-model="numberMargin" type="number" step="any" min="0" class="mt-2 px-4 h-11 w-full text-ink bg-surface border border-line rounded-xl">
        </div>
      </div>

      <div class="grid gap-4 grid-cols-1 md:grid-cols-4 mt-4">
        <div class="md:col-span-3">
          <label for="question-explanation" class="block font-medium text-ink text-sm">Explanation</label>
          <input id="question-explanation" x-model="explanation" type="text" aria-describedby="question-explanation-help" class="mt-2 px-4 h-11 w-full text-ink bg-surface border border-line rounded-xl">
          <p id="question-explanation-help" class="mt-2 text-muted text-sm">Shown with the result when the quiz reveals answers.</p>
        </div>
        <div>
          <label for="question-points" class="block font-medium text-ink text-sm">Points</label>
          <input id="question-points" x-model="points" type="number" min="1" max="100" class="mt-2 px-4 h-11 w-full text-ink bg-surface border border-line rounded-xl">
        </div>
      </div>

      <div class="flex flex-wrap gap-3 mt-5">
        <button type="submit" class="inline-flex items-center px-5 h-11 font-medium text-accent-ink bg-accent rounded-full disabled:opacity-60" :disabled="busy()">{{ editing() ? 'Save question' : 'Add question' }}</button>
        <button type="button" class="inline-flex items-center px-5 h-11 font-medium text-ink border border-line rounded-full" :hidden="editing() === 0" hidden @click="clearForm()">Cancel</button>
      </div>
    </form>

    <form class="mt-8 p-6 bg-surface border border-line rounded-2xl" @submit.prevent="saveSettings()">
      <h2 class="font-semibold text-ink text-xl tracking-tight">How it is sat</h2>
      <div class="grid gap-4 grid-cols-1 sm:grid-cols-3 mt-5">
        <div>
          <label for="quiz-pass" class="block font-medium text-ink text-sm">Pass mark (%)</label>
          <input id="quiz-pass" x-model="passPercent" type="number" min="0" max="100" required class="mt-2 px-4 h-11 w-full text-ink bg-page border border-line rounded-xl">
        </div>
        <div>
          <label for="quiz-attempts" class="block font-medium text-ink text-sm">Attempts</label>
          <input id="quiz-attempts" x-model="maxAttempts" type="number" min="1" max="100" aria-describedby="quiz-attempts-help" class="mt-2 px-4 h-11 w-full text-ink bg-page border border-line rounded-xl">
          <p id="quiz-attempts-help" class="mt-2 text-muted text-sm">Empty for no limit.</p>
        </div>
        <div>
          <label for="quiz-minutes" class="block font-medium text-ink text-sm">Time limit (minutes)</label>
          <input id="quiz-minutes" x-model="limitMinutes" type="number" min="1" max="1440" aria-describedby="quiz-minutes-help" class="mt-2 px-4 h-11 w-full text-ink bg-page border border-line rounded-xl">
          <p id="quiz-minutes-help" class="mt-2 text-muted text-sm">Empty for untimed.</p>
        </div>
      </div>
      <div class="grid gap-4 grid-cols-1 sm:grid-cols-2 mt-4">
        <div>
          <label for="quiz-reveal" class="block font-medium text-ink text-sm">Show the right answers</label>
          <select id="quiz-reveal" x-model="reveal" class="mt-2 px-3 h-11 w-full text-ink bg-page border border-line rounded-xl">
            <option value="after_submit">After every attempt</option>
            <option value="after_pass">Only after passing</option>
            <option value="never">Never</option>
          </select>
        </div>
        <div>
          <p class="font-medium text-ink text-sm">Question order</p>
          <button type="button" class="inline-flex items-center mt-2 px-4 h-11 text-sm border rounded-full" :class="shuffle() ? 'border-accent bg-accent-soft text-ink' : 'border-line text-muted'" :aria-pressed="shuffle()" @click="shuffle.set(!shuffle())">{{ shuffle() ? 'Shuffled for each attempt' : 'As written' }}</button>
        </div>
      </div>
      <div class="flex flex-wrap gap-4 items-center mt-5">
        <button type="submit" class="inline-flex items-center px-5 h-11 font-medium text-ink border border-line rounded-full disabled:opacity-60" :disabled="busy()">Save settings</button>
        <p class="text-muted text-sm" role="status" x-text="saved()"></p>
      </div>
    </form>
  </div>
</div>
</template>
@endsection
